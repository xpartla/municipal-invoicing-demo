{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "tags": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "supplier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supplier"
        },
        "known_supplier": {
          "description": "The supplier had precedents when it was coded",
          "title": "Known Supplier",
          "type": "boolean"
        },
        "expected_outcome": {
          "enum": [
            "coded",
            "manual_entry"
          ],
          "title": "Expected Outcome",
          "type": "string"
        },
        "expected": {
          "items": {
            "$ref": "#/$defs/LineCodes"
          },
          "title": "Expected",
          "type": "array"
        },
        "proposed": {
          "items": {
            "$ref": "#/$defs/LineCodes"
          },
          "title": "Proposed",
          "type": "array"
        },
        "alternatives": {
          "description": "The proposal's alternatives, best first",
          "items": {
            "pattern": "^\\d{6} \\d[0-9A-Za-z]{1,3} \\d{2} \\d{3} \\d{3}$",
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "correct": {
          "description": "The expected outcome is reproduced: every line's key, MD and DAL, or manual entry, and the number and booking date wherever the scan shows them",
          "title": "Correct",
          "type": "boolean"
        },
        "full_key": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Every budget key matches; null for manual entry",
          "title": "Full Key"
        },
        "fields": {
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Per field (ek, zdroj, cofog, analytika, md, dal): every line matches",
          "title": "Fields",
          "type": "object"
        },
        "top3": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The expected key is the chosen one or among the first two alternatives; single-line codings only",
          "title": "Top3"
        },
        "split_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "As many lines as expected; null for manual entry",
          "title": "Split Ok"
        },
        "validation_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when the proposal has no lines",
          "title": "Validation Ok"
        },
        "number_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when the scan's number is unreadable",
          "title": "Number Ok"
        },
        "date_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when the scan's booking date is unreadable",
          "title": "Date Ok"
        },
        "needs_review": {
          "title": "Needs Review",
          "type": "boolean"
        },
        "expected_review": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Review"
        },
        "review_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "known_supplier",
        "expected_outcome",
        "correct",
        "full_key",
        "needs_review",
        "confidence"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "LineCodes": {
      "additionalProperties": false,
      "description": "What the accountant types for one line: the budget key, MD and DAL.",
      "properties": {
        "key": {
          "pattern": "^\\d{6} \\d[0-9A-Za-z]{1,3} \\d{2} \\d{3} \\d{3}$",
          "title": "Key",
          "type": "string"
        },
        "md": {
          "pattern": "^\\d{3} \\d{3}$",
          "title": "Md",
          "type": "string"
        },
        "dal": {
          "pattern": "^\\d{3} \\d{3}$",
          "title": "Dal",
          "type": "string"
        }
      },
      "required": [
        "key",
        "md",
        "dal"
      ],
      "title": "LineCodes",
      "type": "object"
    },
    "Rate": {
      "additionalProperties": false,
      "properties": {
        "hits": {
          "minimum": 0,
          "title": "Hits",
          "type": "integer"
        },
        "n": {
          "description": "Cases the metric applies to",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "hits / n, null when n is 0",
          "title": "Value"
        }
      },
      "required": [
        "hits",
        "n",
        "value"
      ],
      "title": "Rate",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "number"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "met": {
          "title": "Met",
          "type": "boolean"
        }
      },
      "required": [
        "metric",
        "target",
        "value",
        "met"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entity_ico": {
      "pattern": "^\\d{8}$",
      "title": "Entity Ico",
      "type": "string"
    },
    "split": {
      "enum": [
        "anchor",
        "seed",
        "heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "memory": {
      "description": "frozen: the anchor and seed cases feed supplier memory before any case is coded, and the coded cases never do (held-out). online: the cases are coded in booking-date order and each one feeds memory after it is coded (anchor, seed)",
      "enum": [
        "frozen",
        "online"
      ],
      "title": "Memory",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "dataset_sha256": {
      "description": "Digest of the evaluated split's case files",
      "title": "Dataset Sha256",
      "type": "string"
    },
    "precedent_cases": {
      "description": "Dataset cases fed into supplier memory",
      "title": "Precedent Cases",
      "type": "integer"
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/Rate"
      },
      "title": "Metrics",
      "type": "object"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/Target"
      },
      "title": "Targets",
      "type": "array"
    },
    "by_supplier": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/Rate"
        },
        "type": "object"
      },
      "description": "'known' and 'new' suppliers",
      "title": "By Supplier",
      "type": "object"
    },
    "by_tag": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/Rate"
        },
        "type": "object"
      },
      "title": "By Tag",
      "type": "object"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "entity_ico",
    "split",
    "memory",
    "generated_at",
    "engine_version",
    "bundle_id",
    "dataset_sha256",
    "precedent_cases",
    "metrics",
    "targets",
    "by_supplier",
    "by_tag",
    "cases"
  ],
  "title": "EvalReport",
  "type": "object"
}
